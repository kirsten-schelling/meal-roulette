{
  "db_name": "PostgreSQL",
  "query": "\n        WITH updated AS (\n            UPDATE recipe_ingredient\n            SET qty = COALESCE($3, qty),\n                note = COALESCE($4, note),\n                optional = COALESCE($5, optional)\n            WHERE recipe_id = $1 AND ingredient_id = $2\n            RETURNING id, created_at, updated_at, recipe_id, ingredient_id, qty, note, optional\n        )\n        SELECT\n            updated.id,\n            updated.created_at,\n            updated.updated_at,\n            updated.recipe_id,\n            updated.ingredient_id,\n            ingredient.name AS ingredient_name,\n            unit.name AS unit,\n            updated.qty,\n            updated.note,\n            updated.optional\n        FROM updated\n        JOIN ingredient ON updated.ingredient_id = ingredient.id\n        JOIN unit ON ingredient.unit_id = unit.id\n        ",
