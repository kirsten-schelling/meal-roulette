  "query": "\n        SELECT cook_log.id, cook_log.recipe_id, recipe.title, cook_log.cooked_on\n        FROM cook_log\n        JOIN recipe ON recipe.id = cook_log.recipe_id\n        ORDER BY cook_log.cooked_on DESC, cook_log.created_at DESC\n        ",
