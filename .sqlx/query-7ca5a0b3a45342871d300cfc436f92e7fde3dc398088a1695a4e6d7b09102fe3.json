  "query": "\n        UPDATE cook_log\n        SET recipe_id = COALESCE($1, recipe_id),\n            planned_meal_id = COALESCE($2, planned_meal_id),\n            cooked_on = COALESCE($3, cooked_on)\n        WHERE id = $4\n        RETURNING id, household_id, recipe_id, planned_meal_id, cooked_on, created_at, updated_at\n        ",
