  "query": "\n        SELECT recipe.id, recipe.title AS name\n        FROM recipe\n        WHERE EXISTS (\n            SELECT 1 FROM recipe_ingredient\n            WHERE recipe_ingredient.recipe_id = recipe.id\n              AND recipe_ingredient.ingredient_id = $1\n        )\n        ORDER BY recipe.title, recipe.id\n        ",
