  "query": "\n        INSERT INTO recipe_tag (recipe_id, tag_id)\n        SELECT $1, tag_id FROM unnest($2::uuid[]) AS tag_id\n        ON CONFLICT ON CONSTRAINT uq_recipe_tag DO NOTHING\n        RETURNING id, recipe_id, tag_id, created_at, updated_at\n        ",
