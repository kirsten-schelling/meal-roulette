{
  "db_name": "PostgreSQL",
  "query": "\n        WITH deleted AS (\n            DELETE FROM recipe_ingredient\n            WHERE recipe_id = $1 AND ingredient_id = $2\n            RETURNING id, created_at, updated_at, recipe_id, ingredient_id, qty, note, optional\n        )\n        SELECT\n            deleted.id,\n            deleted.created_at,\n            deleted.updated_at,\n            deleted.recipe_id,\n            deleted.ingredient_id,\n            ingredient.name AS ingredient_name,\n            unit.name AS unit,\n            deleted.qty,\n            deleted.note,\n            deleted.optional\n        FROM deleted\n        JOIN ingredient ON deleted.ingredient_id = ingredient.id\n        JOIN unit ON ingredient.unit_id = unit.id\n        ",
