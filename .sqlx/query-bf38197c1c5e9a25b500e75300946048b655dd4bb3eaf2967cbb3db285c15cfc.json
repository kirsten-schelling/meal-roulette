  "query": "\n        UPDATE recipe\n        SET title = $1,\n            difficulty = $2,\n            time_mins = $3,\n            servings = $4,\n            healthiness = $5,\n            min_gap_weeks = $6,\n            max_gap_weeks = $7,\n            main_protein_id = $8,\n            cuisine_id = $9\n        WHERE id = $10\n        RETURNING id, household_id, title, difficulty, time_mins, servings,\n                  healthiness, min_gap_weeks, max_gap_weeks, main_protein_id, cuisine_id,\n                  created_at, updated_at\n        ",
